t-size:13px;color:var(--muted);margin-top:4px}\n.plan .cta{margin-top:14px;display:inline-block;background:var(--deep);color:#f3ede2;border-radius:999px;padding:9px 18px;font-size:13px;font-weight:700;letter-spacing:.05em}\n.plan:nth-child(2) .cta{background:var(--amber);color:var(--deep)}\n.plans-note{margin-top:22px;font-size:13px;color:var(--muted);max-width:760px}\n\n/* FAQ */\n.faq{background:var(--deep);color:#f3ede2}\n.faq .section-head h2{color:#fff}\n.faq .section-head p{color:#bdb2a1}\n.faq-groups{display:grid;grid-template-columns:1fr 1fr;gap:26px}\n.faq-group{background:rgba(243,237,226,.05);border:1px solid rgba(243,237,226,.14);border-radius:var(--radius);padding:26px 28px}\n.faq-group h3{font-size:13px;letter-spacing:.18em;text-transform:uppercase;color:var(--amber);margin-bottom:18px}\n.qa{margin-bottom:20px}\n.qa:last-child{margin-bottom:0}\n.qa .q{font-weight:800;font-size:15px;color:#fff;margin-bottom:6px;line-height:1.5}\n.qa .a{font-size:13.8px;color:#cfc4b2;line-height:1.75;margin:0}\n\n/* FOOTER */\nfooter{background:var(--ink);color:#a99e8d;padding:38px 0;font-size:13px}\n.foot{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;align-items:center}\n.foot .brand-lockup{color:#f3ede2}\n.foot nav{display:flex;gap:18px;flex-wrap:wrap}\n.foot nav a{border-bottom:1px solid transparent}\n.foot nav a:hover{border-color:var(--amber)}\n\n@media (max-width:980px){\n  .hero-grid{grid-template-columns:1fr 1fr;gap:26px;padding:38px 0 44px}\n  .hero h1{grid-column:1 / span 2}\n  .hero-lead{grid-column:1 / span 2}\n  .quote{grid-column:1 / span 2}\n  .hero-panel{grid-column:1 / span 2;grid-row:auto}\n  .hero-cols{grid-template-columns:1fr}\n  .hero-cols div{border-right:0;border-bottom:1px solid rgba(243,237,226,.12)}\n  .usage-grid{grid-template-columns:1fr 1fr}\n  .client-grid{grid-template-columns:1fr}\n  .plan{grid-template-columns:1fr 1fr}\n  .plan .price-wrap{grid-column:1 / span 2;text-align:left}\n  .plan:nth-child(2),.plan:nth-child(3){margin-left:0}\n  .faq-groups{grid-template-columns:1fr}\n}\n@media (max-width:600px){\n  .wrap{width:calc(100% - 28px)}\n  .section{padding:52px 0}\n  .hero-top{flex-direction:column;align-items:flex-start}\n  .usage-grid{grid-template-columns:1fr}\n  .plan{grid-template-columns:1fr;padding:24px}\n  .plan .price-wrap{grid-column:auto}\n  .price{font-size:26px}\n  .hero-panel{padding:18px}\n}\n</style><header class=\"hero\">\n  <div class=\"wrap\">\n    <div class=\"hero-top\">\n      <div class=\"brand-lockup\"><span class=\"brand-mark\">飞</span>飞马</div>\n      <nav class=\"hero-nav\" aria-label=\"首屏内嵌锚点\">\n        <a href=\"#usage\">使用说明</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#plans\">套餐</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n    </div>\n\n    <div class=\"hero-grid\">\n      <h1>飞马<br><em>把连接说清楚</em></h1>\n      <p class=\"hero-lead\">一个页面讲完三件事：怎么用、在哪用、多少钱。没有绕弯子的说法，只有可以直接对照的条目。</p>\n      <blockquote class=\"quote\">\n        “先看说明，再看价格。顺序对了，选择就不难。”\n        飞马 · 页面编辑说明\n      </blockquote>\n\n      <div class=\"hero-panel\">\n        <h3>页面速览</h3>\n        <dl>\n          <div>\n            <dt>文档结构</dt>\n            <dd>使用说明 · 客户端 · 套餐 · 常见问题</dd>\n          </div>\n          <div>\n            <dt>套餐档位</dt>\n            <dd>基础版 / 旗舰版 / 团队版</dd>\n          </div>\n          <div>\n            <dt>说明口径</dt>\n            <dd>短句、条目、可对照</dd>\n          </div>\n        </dl>\n        <p class=\"note\">本页为信息展示页。具体可用性、节点与支持范围以实际服务说明为准。</p>\n      </div>\n    </div>\n\n    <div class=\"hero-cols\">\n      <div>\n        <h4>先读说明</h4>\n        <p>四步上手，不跳步。每一步只做一件事。</p>\n      </div>\n      <div>\n        <h4>再选客户端</h4>\n        <p>按设备类型挑选，安装后按引导完成配置。</p>\n      </div>\n      <div>\n        <h4>最后看套餐</h4>\n        <p>三档阶梯排列，流量与设备数逐级增加。</p>\n      </div>\n    </div>\n  </div>\n</header>\n\n<main>\n  <section class=\"section usage\" id=\"usage\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <div>\n          <p class=\"eyebrow\">Usage</p>\n          <h2>使用说明</h2>\n        </div>\n        <p>按顺序完成四步即可开始使用。若中途遇到问题，先回到上一步核对。</p>\n      </div>\n      <div class=\"usage-grid\">\n        <article class=\"step\">\n          <div class=\"num\">01</div>\n          <h3>确认套餐</h3>\n          <p>先看基础版、旗舰版、团队版的流量与设备数，选与日常用量匹配的一档，避免中途更换。</p>\n        </article>\n        <article class=\"step\">\n          <div class=\"num\">02</div>\n          <h3>安装客户端</h3>\n          <p>根据设备选择对应客户端，安装完成后打开应用，按界面提示进入配置环节。</p>\n        </article>\n        <article class=\"step\">\n          <div class=\"num\">03</div>\n          <h3>导入配置</h3>\n          <p>在客户端内使用服务提供的配置信息完成导入。不要修改来源不明的配置文本。</p>\n        </article>\n        <article class=\"step\">\n          <div class=\"num\">04</div>\n          <h3>验证连接</h3>\n          <p>连接后打开常用页面确认可访问。若未生效，检查客户端状态与设备网络环境。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <hr class=\"rule\">\n\n  <section class=\"section clients\" id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <div>\n          <p class=\"eyebrow\">Clients</p>\n          <h2>客户端</h2>\n        </div>\n        <p>按设备类型选择客户端。这里只说明用途与适配方向，下载入口以服务方实际提供为准。</p>\n      </div>\n      <div class=\"client-grid\">\n        <article class=\"client\">\n          <div class=\"plat\">桌面端</div>\n          <h3>飞马桌面客户端</h3>\n          <p>面向 Windows 与 macOS 的桌面使用场景，适合长时间在线与多窗口操作。安装后可随系统启动。</p>\n          <a class=\"download\" href=\"#\">下载入口请以服务说明为准</a>\n        </article>\n        <article class=\"client\">\n          <div class=\"plat\">移动端</div>\n          <h3>飞马移动客户端</h3>\n          <p>面向 Android 与 iOS 的移动场景，适合外出时使用。连接状态以客户端内显示为准。</p>\n          <a class=\"download\" href=\"#\">下载入口请以服务说明为准</a>\n        </article>\n        <article class=\"client\">\n          <div class=\"plat\">路由与扩展</div>\n          <h3>飞马路由器配置</h3>\n          <p>适合家庭与小型办公网络统一接入。请在具备配置经验的设备上操作，避免误改原有网络设置。</p>\n          <a class=\"download\" href=\"#\">配置说明请以服务文档为准</a>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <hr class=\"rule\">\n\n  <section class=\"section plans\" id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <div>\n          <p class=\"eyebrow\">Plans</p>\n          <h2>套餐</h2>\n        </div>\n        <p>三档自下而上排列。流量与设备数逐级增加，按需选择即可。</p>\n      </div>\n      <div class=\"stairs\">\n        <article class=\"plan\">\n          <div class=\"plan-head\">\n            <span class=\"name\">基础版</span>\n            <span class=\"small\">日常轻量使用</span>\n          </div>\n          <ul>\n            <li>每月 100GB 流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <div class=\"price-wrap\">\n            <div class=\"price\">¥15 <span>/ 月</span></div>\n            <div class=\"annual\">按年付仅需 ¥150 / 年</div>\n            <a class=\"cta\" href=\"#\">了解基础版</a>\n          </div>\n        </article>\n\n        <article class=\"plan\">\n          <div class=\"plan-head\">\n            <span class=\"name\">旗舰版</span>\n            <span class=\"rec\">推荐</span>\n            <span class=\"small\">多设备与流媒体</span>\n          </div>\n          <ul>\n            <li>每月 300GB 流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n          <div class=\"price-wrap\">\n            <div class=\"price\">¥35 <span>/ 月</span></div>\n            <div class=\"annual\">按年付仅需 ¥350 / 年</div>\n            <a class=\"cta\" href=\"#\">了解旗舰版</a>\n          </div>\n        </article>\n\n        <article class=\"plan\">\n          <div class=\"plan-head\">\n            <span class=\"name\">团队版</span>\n            <span class=\"small\">小团队与办公网络</span>\n          </div>\n          <ul>\n            <li>每月 1000GB 流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <div class=\"price-wrap\">\n            <div class=\"price\">¥85 <span>/ 月</span></div>\n            <div class=\"annual\">按年付仅需 ¥850 / 年</div>\n            <a class=\"cta\" href=\"#\">了解团队版</a>\n          </div>\n        </article>\n      </div>\n      <p class=\"plans-note\">以上价格为页面展示信息，权益以实际服务说明为准。年付金额按对应档位列出，不额外叠加其他折扣。</p>\n    </div>\n  </section>\n\n  <section class=\"section faq\" id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <div>\n          <p class=\"eyebrow\">FAQ</p>\n          <h2>常见问题</h2>\n        </div>\n        <p>按主题分组：账户与套餐、客户端与设备、使用与支持。答案只讲必要的部分。</p>\n      </div>\n      <div class=\"faq-groups\">\n        <article class=\"faq-group\">\n          <h3>账户与套餐</h3>\n          <div class=\"qa\">\n            <div class=\"q\">三档套餐的主要区别是什么？</div>\n            <p class=\"a\">主要看三点：每月流量、同时在线设备数、以及节点类型。基础版适合轻量使用，旗舰版覆盖多设备与流媒体场景，团队版面向更高流量与多人协作。</p>\n          </div>\n          <div class=\"qa\">\n            <div class=\"q\">年付与月付有什么区别？</div>\n            <p class=\"a\">年付按页面所列对应金额结算，页面已标注各档年付价格。选择前请确认使用周期，避免中途变更造成不便。</p>\n          </div>\n          <div class=\"qa\">\n            <div class=\"q\">可以先试用再决定吗？</div>\n            <p class=\"a\">页面不承诺试用安排。是否需要试用、以何种方式进行，需以服务方实际说明为准，本页不做额外承诺。</p>\n          </div>\n        </article>\n\n        <article class=\"faq-group\">\n          <h3>客户端与设备</h3>\n          <div class=\"qa\">\n            <div class=\"q\">同时在线设备数如何计算？</div>\n            <p class=\"a\">按同时保持连接的设备数量计算。基础版 3 台、旗舰版 5 台、团队版 20 台。超出数量时，后连接的设备可能无法保持连接。</p>\n          </div>\n          <div class=\"qa\">\n            <div class=\"q\">路由器配置需要额外条件吗？</div>\n            <p class=\"a\">需要一台可进行配置操作的路由器，并对原有网络设置有一定了解。若不确定，建议先在桌面或移动客户端上完成配置与验证。</p>\n          </div>\n          <div class=\"qa\">\n            <div class=\"q\">更换设备后需要重新配置吗？</div>\n            <p class=\"a\">通常需要在新设备上重新安装客户端并导入配置。旧设备建议先行退出，避免占用同时在线数量。</p>\n          </div>\n        </article>\n\n        <article class=\"faq-group\">\n          <h3>使用与支持</h3>\n          <div class=\"qa\">\n            <div class=\"q\">连接不生效时先检查什么？</div>\n            <p class=\"a\">先看客户端是否处于连接状态，再确认设备网络可用。若仍无效，核对配置是否完整导入，必要时重新导入一次。</p>\n          </div>\n          <div class=\"qa\">\n            <div class=\"q\">工单支持的响应方式是什么？</div>\n            <p class=\"a\">旗舰版与团队版包含优先或专属支持入口。具体响应时间与处理流程以服务方说明为准，本页不额外承诺时效。</p>\n          </div>\n          <div class=\"qa\">\n            <div class=\"q\">流量用完后怎么办？</div>\n            <p class=\"a\">当月流量用尽后，连接可能受限。可考虑调整至更高一档套餐，或在下一计费周期继续使用。具体规则以服务说明为准。</p>\n          </div>\n        </article>\n\n        <article class=\"faq-group\">\n          <h3>说明与边界</h3>\n          <div class=\"qa\">\n            <div class=\"q\">页面上的价格是否长期有效？</div>\n            <p class=\"a\">页面展示的是当前列出的价格信息，不构成长期价格承诺。若服务方调整价格或权益，应以最新说明为准。</p>\n          </div>\n          <div class=\"qa\">\n            <div class=\"q\">客户端下载链接在哪里？</div>\n            <p class=\"a\">本页不提供固定下载地址，下载入口以服务方页面与客户端内说明为准。请勿从来源不明的第三方渠道获取安装文件。</p>\n          </div>\n          <div class=\"qa\">\n            <div class=\"q\">为什么本页没有写节点数量？</div>\n            <p class=\"a\">节点与线路会随服务情况变化，本页不列出具体数量，避免与实际不一致。需要了解时，请查看服务方的最新说明。</p>\n          </div>\n        </article>\n      </div>\n    </div>\n  </section>\n</main>\n\n<footer>\n  <div class=\"wrap foot\">\n    <div class=\"brand-lockup\"><span class=\"brand-mark\">飞</span>飞马</div>\n    <nav aria-label=\"底部导航\">\n      <a href=\"#usage\">使用说明</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#plans\">套餐</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n    <div>页面内容以实际服务说明为准。</div>\n  </div>\n</footer>",
